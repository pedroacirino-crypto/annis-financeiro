{%- comment -%}
  Catálogo Entretempos online, em annis.store/pages/entretempos.
  Seção "Liquid personalizado" do modelo de página "entretempos".

  As páginas são as do PDF do catálogo (08/10/2026), uma imagem por página,
  em pares (foto e preço) que ficam lado a lado no computador,
  idênticas ao que vai no WhatsApp: o texto do PDF é desenho, não letra, e
  refazer em fonte do site deixaria diferente. As imagens estão em Conteúdo >
  Arquivos com o nome entretempos-p01.webp a p13.

  O nome da cliente vem do link (?n=Leticia) e só aparece nas faixas de cima e
  de baixo, nas fontes do site. O texto da faixa de cima é do Pedro (08/10). Sem nome, a página fica genérica. O nome não é
  guardado em lugar nenhum.

  Os botões de comprar levam pelo /discount/ENTRETEMPOS10, que aplica os 10%
  antes de abrir a peça. O cupom vale para a loja inteira, então o botão do
  final abre o Shop. As páginas do PDF mostram preço cheio; a linha "sai por"
  embaixo de cada uma vem do preço do produto na Shopify, menos 10%.
{%- endcomment -%}

{%- liquid
  assign desconto = '/discount/ENTRETEMPOS10?redirect='
-%}

<style>
  .annis-cat { --vinho: #5E2825; --creme: #F3E1D2; background: #FFF6F0; padding: 0 0 48px; }
  /* O fundo do site nesta página é branco e o tema deixa margem dos lados;
     a sombra estende o creme até a borda da tela sem criar rolagem lateral. */
  .annis-cat { box-shadow: 0 0 0 100vmax #FFF6F0; clip-path: inset(0 -100vmax); }
  /* No celular o tema deixa margem dos lados; o catálogo vai de borda a borda. */
  @media (max-width: 749px) { .annis-cat { width: 100vw; margin-left: calc(50% - 50vw); padding-bottom: 0; } }
  .annis-cat * { box-sizing: border-box; }
  .annis-cat__coluna { max-width: 480px; margin: 0 auto; }
  .annis-cat__pagina { display: block; width: 100%; aspect-ratio: 9 / 16; height: auto; background: var(--creme); }
  .annis-cat__faixa { padding: 36px 28px; text-align: center; font-family: Poppins, sans-serif; }
  .annis-cat__faixa--vinho { background: var(--vinho); color: var(--creme); }
  .annis-cat__faixa--creme { background: var(--creme); color: var(--vinho); }
  .annis-cat__ola { font-family: Newsreader, serif; font-style: italic; font-size: 34px; line-height: 1.15; margin: 0 0 6px; }
  .annis-cat__frase { font-family: Newsreader, serif; font-size: 22px; line-height: 1.35; margin: 0 0 14px; }
  .annis-cat__texto { font-family: Newsreader, serif; font-size: 22px; line-height: 1.35; margin: 0 0 14px; }
  .annis-cat__nota { font-size: 13px; line-height: 1.6; margin: 18px 0 0; opacity: .85; }
  .annis-cat__botoes { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; padding: 0 20px 28px; }
  .annis-cat__botoes--vinho { background: var(--vinho); }
  .annis-cat__botoes--creme { background: var(--creme); }
  .annis-cat__botao { flex: 1 1 130px; max-width: 200px; padding: 13px 10px; border-radius: 0; text-align: center; text-decoration: none;
    font-family: Poppins, sans-serif; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
  .annis-cat__desconto { flex: 1 1 100%; margin: 0 0 6px; text-align: center; font-family: Newsreader, serif; font-size: 19px; line-height: 1.3; }
  .annis-cat__desconto strong { font-weight: 600; }
  .annis-cat__desconto small { display: block; font-family: Poppins, sans-serif; font-size: 12px; line-height: 1.5; margin-top: 4px; opacity: .85; }
  .annis-cat__botoes--vinho .annis-cat__desconto { color: var(--creme); }
  .annis-cat__botoes--creme .annis-cat__desconto { color: var(--vinho); }
  .annis-cat__botoes--vinho .annis-cat__botao { background: var(--creme); color: var(--vinho); }
  .annis-cat__botoes--creme .annis-cat__botao { background: var(--vinho); color: var(--creme); }
  .annis-cat__faixa .annis-cat__botao { display: inline-block; margin-top: 20px; background: var(--creme); color: var(--vinho); max-width: none; padding: 14px 28px; }

  /* Computador: o catálogo vira revista aberta, em páginas duplas (foto da
     peça e página de preço lado a lado), na altura da tela. O preço com os
     10% e os botões ficam embaixo de cada par, no fundo do site. */
  @media (min-width: 750px) {
    .annis-cat { --pag-h: min(calc(100vh - 170px), 940px); --pag-w: calc(var(--pag-h) * 9 / 16); padding: 40px 0 72px; }
    .annis-cat__coluna { max-width: calc(var(--pag-w) * 2); }
    .annis-cat__par { display: grid; grid-template-columns: 1fr 1fr; margin-top: 56px; }
    .annis-cat__faixa + .annis-cat__par { margin-top: 40px; }
    .annis-cat__par--uma { grid-template-columns: 1fr; width: var(--pag-w); margin-left: auto; margin-right: auto; }
    .annis-cat__faixa { padding: 48px 72px; }
    .annis-cat__par + .annis-cat__faixa { margin-top: 56px; }
    .annis-cat__botoes { background: transparent; padding: 22px 0 0; }
    .annis-cat__botoes .annis-cat__desconto { color: var(--vinho); }
    .annis-cat__botoes .annis-cat__botao { background: var(--vinho); color: var(--creme); }
  }
</style>

<div class="annis-cat">
  <div class="annis-cat__coluna">

    <div class="annis-cat__faixa annis-cat__faixa--vinho">
      <p class="annis-cat__ola" data-annis-ola hidden></p>
      <p class="annis-cat__frase" data-annis-abre>A Entretempos chegou.</p>
      <p class="annis-cat__texto">É uma alegria ter você com a gente e fazer parte da sua história com a Annis.</p>
      <p class="annis-cat__texto">Para agradecer, preparamos um presente especial: 10% OFF em toda a coleção Entretempos e frete grátis na sua compra, para você descobrir suas novas peças favoritas.</p>
      <p class="annis-cat__nota">Os 10% se aplicam no checkout. Use o cupom ENTRETEMPOSFRETE para ter frete grátis.</p>
    </div>

    {%- comment -%} Página, e depois dela os botões de comprar quando é página de preço. {%- endcomment -%}
    {%- liquid
      assign paginas = '01,02,03,04,05,06,07,08,09,10,11,12,13' | split: ','
    -%}
    {%- for n in paginas -%}
      {%- capture arquivo -%}entretempos-p{{ n }}.webp{%- endcapture -%}
      {%- assign impar = n | plus: 0 | modulo: 2 -%}
      {%- if impar == 1 -%}<div class="annis-cat__par{% if n == '13' %} annis-cat__par--uma{% endif %}">{%- endif -%}
      <img class="annis-cat__pagina" src="{{ arquivo | file_url }}" width="1080" height="1920"
        alt="Catálogo Entretempos, página {{ n | plus: 0 }}" {% if forloop.index > 2 %}loading="lazy"{% endif %} decoding="async">
      {%- if impar == 0 or n == '13' -%}</div>{%- endif -%}

      {%- comment -%} Preço com os 10%, parcela sem juros e Pix, na mesma regra da página
          de produto (até 6x sem juros com parcela mínima de R$ 50, 5% no Pix). {%- endcomment -%}
      {%- liquid
        assign h = ''
        case n
          when '04'
            assign h = 'camisa-de-algodao-heranca-rosa'
          when '06'
            assign h = 'vestido-de-jacquard-relicario-vinho'
          when '08'
            assign h = 'colete-de-jacquard-trama-vinho'
          when '10'
            assign h = 'calca-de-jacquard-trama-vinho'
          when '12'
            assign h = 'bolsa-jacquard-reliquia-vinho'
        endcase
        if h != ''
          assign com10 = all_products[h].price | times: 9 | divided_by: 10
          assign pix10 = com10 | times: 95 | divided_by: 100
          assign vezes = 1
          assign parcela10 = com10
          for k in (2..6)
            assign parc = com10 | plus: k | minus: 1 | divided_by: k
            if parc >= 5000
              assign vezes = k
              assign parcela10 = parc
            endif
          endfor
        endif
      -%}
      {%- case n -%}
        {%- when '04' -%}
          <div class="annis-cat__botoes annis-cat__botoes--vinho">
            <p class="annis-cat__desconto">Com os seus 10%, sai por <strong>{{ com10 | money }}</strong><small>{% if vezes > 1 %}{{ vezes }}x de {{ parcela10 | money }} sem juros ou {% endif %}{{ pix10 | money }} no Pix</small></p>
            <a class="annis-cat__botao" href="{{ desconto }}/products/camisa-de-algodao-heranca-rosa">Comprar rosa</a>
            <a class="annis-cat__botao" href="{{ desconto }}/products/camisa-de-algodao-heranca-branca">Comprar branca</a>
          </div>
        {%- when '06' -%}
          <div class="annis-cat__botoes annis-cat__botoes--creme">
            <p class="annis-cat__desconto">Com os seus 10%, sai por <strong>{{ com10 | money }}</strong><small>{% if vezes > 1 %}{{ vezes }}x de {{ parcela10 | money }} sem juros ou {% endif %}{{ pix10 | money }} no Pix</small></p>
            <a class="annis-cat__botao" href="{{ desconto }}/products/vestido-de-jacquard-relicario-vinho">Comprar vinho</a>
            <a class="annis-cat__botao" href="{{ desconto }}/products/vestido-de-jacquard-relicario-cinza">Comprar cinza</a>
          </div>
        {%- when '08' -%}
          <div class="annis-cat__botoes annis-cat__botoes--vinho">
            <p class="annis-cat__desconto">Com os seus 10%, sai por <strong>{{ com10 | money }}</strong><small>{% if vezes > 1 %}{{ vezes }}x de {{ parcela10 | money }} sem juros ou {% endif %}{{ pix10 | money }} no Pix</small></p>
            <a class="annis-cat__botao" href="{{ desconto }}/products/colete-de-jacquard-trama-vinho">Comprar vinho</a>
            <a class="annis-cat__botao" href="{{ desconto }}/products/colete-de-jacquard-trama-marrom">Comprar marrom</a>
          </div>
        {%- when '10' -%}
          <div class="annis-cat__botoes annis-cat__botoes--creme">
            <p class="annis-cat__desconto">Com os seus 10%, sai por <strong>{{ com10 | money }}</strong><small>{% if vezes > 1 %}{{ vezes }}x de {{ parcela10 | money }} sem juros ou {% endif %}{{ pix10 | money }} no Pix</small></p>
            <a class="annis-cat__botao" href="{{ desconto }}/products/calca-de-jacquard-trama-vinho">Comprar vinho</a>
            <a class="annis-cat__botao" href="{{ desconto }}/products/calca-de-jacquard-trama-marrom">Comprar marrom</a>
          </div>
        {%- when '12' -%}
          <div class="annis-cat__botoes annis-cat__botoes--vinho">
            <p class="annis-cat__desconto">Com os seus 10%, sai por <strong>{{ com10 | money }}</strong><small>{% if vezes > 1 %}{{ vezes }}x de {{ parcela10 | money }} sem juros ou {% endif %}{{ pix10 | money }} no Pix</small></p>
            <a class="annis-cat__botao" href="{{ desconto }}/products/bolsa-jacquard-reliquia-vinho">Comprar vinho</a>
            <a class="annis-cat__botao" href="{{ desconto }}/products/bolsa-de-jacquard-reliquia-cinza">Comprar cinza</a>
            <a class="annis-cat__botao" href="{{ desconto }}/products/bolsa-de-jacquard-reliquia-mostarda">Comprar mostarda</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}

    <div class="annis-cat__faixa annis-cat__faixa--vinho">
      <p class="annis-cat__frase" data-annis-fecha>Qualquer dúvida de tamanho ou prazo, é só responder a nossa mensagem.</p>
      <a class="annis-cat__botao" href="{{ desconto }}/collections/shop">Ver toda a loja</a>
    </div>

  </div>
</div>

<script>
  /* Página só de link: fora dos menus, e aqui pedindo para buscador não
     indexar. O tema não deixa a seção escrever no <head>, então entra por
     script, que o Google lê ao renderizar. */
  (function () {
    var m = document.createElement('meta');
    m.name = 'robots';
    m.content = 'noindex, nofollow';
    document.head.appendChild(m);
  })();

  /* Primeiro nome do link (?n=Leticia ou ?n=Letícia). Só letras, até 20,
     primeira maiúscula; qualquer outra coisa é ignorada e a página fica
     genérica. Entra como texto, nunca como HTML. */
  (function () {
    var bruto = new URLSearchParams(location.search).get('n') || '';
    var nome = (bruto.trim().split(/\s+/)[0] || '').replace(/[^A-Za-zÀ-ÖØ-öø-ÿ'-]/g, '').slice(0, 20);
    if (nome.length < 2) return;
    nome = nome.toLowerCase().replace(/(^|-)(.)/g, function (m, a, b) { return a + b.toUpperCase(); });
    var ola = document.querySelector('[data-annis-ola]');
    ola.textContent = nome + ',';
    ola.hidden = false;
    document.querySelector('[data-annis-abre]').textContent = 'a Entretempos chegou.';
    document.querySelector('[data-annis-fecha]').textContent =
      nome + ', qualquer dúvida de tamanho ou prazo, é só responder a nossa mensagem.';
  })();
</script>
