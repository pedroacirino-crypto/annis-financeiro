    { name: "Rodapé", used: "todos", desc: "O ANNIS grande do rodapé do site, com contato.", html: P.rodape() }
  ];

  var zoom = document.getElementById("zoom");
  var zoomBody = document.getElementById("zoom-body");
  var zoomTitle = document.getElementById("zoom-title");
  var SCALE = 0.56;

  function emailEl(width, html) {
    var em = document.createElement("div");
    em.className = "em";
    em.style.width = width + "px";
    em.innerHTML = html;
    return em;
  }

  function frame(label, width, html, scale) {
    var f = document.createElement("div");
    f.className = "frame";
    var l = document.createElement("span");
    l.className = "frame-label";
    l.textContent = label + " · " + width + " px";
    var box = document.createElement("div");
    box.className = "frame-box";
    var em = emailEl(width, html);
    box.style.width = Math.round(width * scale) + "px";
    if (scale !== 1) em.style.transform = "scale(" + scale + ")";
    box.appendChild(em);
    f.appendChild(l);
    f.appendChild(box);
    function fit() { box.style.height = Math.ceil(em.offsetHeight * scale) + "px"; }
    if (window.ResizeObserver) new ResizeObserver(fit).observe(em);
    em.querySelectorAll("img").forEach(function (img) { img.addEventListener("load", fit); });
    requestAnimationFrame(fit);
    return f;
  }

  function render(containerId, list, prefix, scale) {
    var gallery = document.getElementById(containerId);
    if (!gallery) return;
    list.forEach(function (b, i) {
      var wrap = document.createElement("article");
      wrap.className = "blk";
      var head = document.createElement("div");
      head.className = "blk-head";
      head.innerHTML = '<h3></h3><span class="used"></span>';
      head.querySelector("h3").textContent = b.name;
      head.querySelector(".used").textContent = b.used;
      var btn = document.createElement("button");
      btn.type = "button";
      btn.id = prefix + "-ampliar-" + i;
      btn.textContent = "Ampliar";
      btn.addEventListener("click", function () {
        zoomTitle.textContent = b.name;
        zoomBody.innerHTML = "";
        zoomBody.appendChild(frame("Computador", 600, b.html, 1));
        zoomBody.appendChild(frame("Celular", 375, b.html, 1));
        if (zoom.showModal) zoom.showModal(); else zoom.setAttribute("open", "");
      });
      head.appendChild(btn);
      var desc = document.createElement("p");
      desc.className = "blk-desc";
      desc.textContent = b.desc;
      var frames = document.createElement("div");
      frames.className = "frames";
      frames.appendChild(frame("Computador", 600, b.html, scale));
      frames.appendChild(frame("Celular", 375, b.html, scale));
      wrap.appendChild(head);
      wrap.appendChild(desc);
      wrap.appendChild(frames);
      gallery.appendChild(wrap);
    });
  }

  render("mails-gallery", MAILS, "email", 0.5);
  render("gallery", BLOCKS, "bloco", SCALE);

  document.getElementById("zoom-close").addEventListener("click", function () {
    if (zoom.close) zoom.close(); else zoom.removeAttribute("open");
  });
  zoom.addEventListener("click", function (e) { if (e.target === zoom && zoom.close) zoom.close(); });
})();

document.querySelectorAll("[data-variants]").forEach(function (box) {
  var buttons = box.querySelectorAll("button[data-show]");
  buttons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      buttons.forEach(function (b) {
        var on = b === btn;
        b.setAttribute("aria-pressed", on ? "true" : "false");
        var target = document.getElementById(b.getAttribute("data-show"));
        if (target) target.hidden = !on;
      });
    });
  });
});
</script>

