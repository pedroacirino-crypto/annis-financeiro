{%- comment -%}
  Régua pós-compra (blueprint e e-mails no padrão), para o design validar.
  Modelo de página "regua" em formato .liquid, sem o layout do tema: a página
  sai igual ao regua-pos-compra.html, só com as imagens apontando para o CDN
  da loja. Fica em annis.store/pages/regua-pos-compra, fora do menu e sem
  indexação. Gerado por Code/ANNIS/regua-para-shopify.py; não editar aqui.
{%- endcomment -%}
{%- layout none -%}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
{%- raw -%}
<title>Régua pós-compra Annis</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&family=Poppins:wght@400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap">
<style>
/* Layout: coluna de leitura de ~880px; no topo a jornada do pedido em trilho, depois um cartão por e-mail com a prévia do e-mail ao lado das regras. Só tema claro (pedido do Pedro). */
:root {
  color-scheme: light;
  --bg: #ffffff;
  --paper: #fbf8f5;        /* fundo das prévias de e-mail, puxado do creme da Annis */
  --ink: #2a2118;          /* texto principal, marrom quase preto */
  --muted: #7a6b5e;        /* textos de apoio */
  --line: #e9e1d8;         /* divisórias */
  --brand: #68380a;        /* marrom do botão da loja */
  --brand-soft: #f4ebe2;   /* fundo de chips e destaques */
  --internal: #3d5a73;     /* contato interno (Telegram), azul ardósia */
  --internal-soft: #e8eef3;
  --done: #4f6b3a;         /* decisão tomada */
  --font-display: "Poppins", "Helvetica Neue", Arial, sans-serif;
  --font-body: "DM Sans", "Helvetica Neue", Arial, sans-serif;
  --step--1: 0.8125rem;
  --step-0: 0.9375rem;
  --step-1: 1.125rem;
  --step-2: 1.5rem;
  --step-3: 2.125rem;
}
body { background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: var(--step-0); line-height: 1.55; }
.wrap { max-width: 880px; margin: 0 auto; padding-inline: 20px; padding-block: 40px 72px; display: grid; gap: 56px; }
h1, h2, h3 { font-family: var(--font-display); font-weight: 500; text-wrap: balance; margin: 0; letter-spacing: -0.01em; }
h1 { font-size: var(--step-3); line-height: 1.15; }
h2 { font-size: var(--step-2); line-height: 1.2; }
h3 { font-size: var(--step-1); line-height: 1.3; }
p { margin: 0; }
.eyebrow { font-family: var(--font-display); font-size: var(--step--1); letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand); font-weight: 500; }
.muted { color: var(--muted); }
.mono { font-variant-numeric: tabular-nums; }

/* Cabeçalho */
header { display: grid; gap: 14px; }
header .lead { font-size: var(--step-1); max-width: 62ch; }
.byline { font-size: var(--step--1); color: var(--muted); }

/* Jornada */
.journey { display: grid; gap: 16px; }
.track { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; border-top: 2px solid var(--brand); }
.stage { padding: 14px 10px 0 0; display: grid; gap: 10px; align-content: start; position: relative; min-width: 0; }
.stage::before { content: ""; position: absolute; top: -7px; left: 0; width: 12px; height: 12px; border-radius: 50%; background: var(--bg); border: 2px solid var(--brand); }
.stage-name { font-family: var(--font-display); font-weight: 500; font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; }
.stage-note { font-size: var(--step--1); color: var(--muted); }
.touch { display: block; text-decoration: none; color: var(--ink); background: var(--brand-soft); border-radius: 6px; padding: 7px 9px; font-size: var(--step--1); line-height: 1.35; }
.touch b { font-family: var(--font-display); font-weight: 600; color: var(--brand); margin-right: 4px; }
.touch.internal { background: var(--internal-soft); }
.touch.internal b { color: var(--internal); }
.touch:hover, .touch:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }
.legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: var(--step--1); color: var(--muted); }
.legend span::before { content: ""; display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; background: var(--brand-soft); border: 1px solid var(--brand); }
.legend span.i::before { background: var(--internal-soft); border-color: var(--internal); }

/* Regras gerais */
.rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 32px; margin: 0; padding: 0; list-style: none; }
.rules li { display: grid; gap: 2px; padding-top: 12px; border-top: 1px solid var(--line); }
.rules strong { font-family: var(--font-display); font-weight: 500; }

/* Cartão de e-mail */
.mails { display: grid; gap: 40px; }
.mail { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 28px; padding-top: 28px; border-top: 1px solid var(--line); scroll-margin-top: 16px; }
.mail-head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
.num { font-family: var(--font-display); font-weight: 600; color: var(--brand); font-size: var(--step-2); line-height: 1; font-variant-numeric: tabular-nums; }
.mail.internal .num { color: var(--internal); }
.tag { font-size: var(--step--1); background: var(--brand-soft); color: var(--brand); border-radius: 999px; padding: 2px 10px; font-weight: 500; }
.mail.internal .tag { background: var(--internal-soft); color: var(--internal); }
.meta { display: grid; gap: 14px; align-content: start; margin: 0; }
.meta div { display: grid; gap: 2px; }
.meta dt { font-family: var(--font-display); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.meta dd { margin: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font-size: var(--step--1); border: 1px solid var(--line); border-radius: 999px; padding: 1px 9px; color: var(--muted); }

/* Prévia de e-mail */
.preview { display: grid; gap: 12px; min-width: 0; }
.variants { display: flex; gap: 6px; flex-wrap: wrap; }
.variants button { font: inherit; font-size: var(--step--1); border: 1px solid var(--line); background: var(--bg); color: var(--muted); border-radius: 999px; padding: 4px 12px; cursor: pointer; }
.variants button[aria-pressed="true"] { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
.variants button:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
.envelope { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
.env-top { padding: 12px 16px; border-bottom: 1px solid var(--line); display: grid; gap: 2px; font-size: var(--step--1); }
.env-top .subj { font-family: var(--font-display); font-weight: 500; font-size: var(--step-0); color: var(--ink); }
.env-body { padding: 20px 18px 22px; display: grid; gap: 12px; background: var(--bg); margin: 12px; border-radius: 6px; }
.env-body .logo { font-family: var(--font-display); letter-spacing: 0.32em; font-weight: 500; color: var(--brand); font-size: var(--step--1); }
.env-body .btn { justify-self: start; background: var(--brand); color: #fff6f0; font-family: var(--font-display); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; padding: 9px 16px; border-radius: 2px; }
.env-body .btn.wa { background: var(--bg); color: var(--brand); border: 1px solid var(--brand); }
.env-body .box { border: 1px dashed var(--brand); color: var(--brand); border-radius: 4px; padding: 8px 10px; font-size: var(--step--1); }
.env-body .sign { color: var(--muted); }
.var { color: var(--brand); font-weight: 500; }
.scale { display: flex; flex-wrap: wrap; gap: 4px; }
.scale span { min-width: 26px; text-align: center; border: 1px solid var(--brand); color: var(--brand); border-radius: 3px; font-size: var(--step--1); padding: 2px 0; font-variant-numeric: tabular-nums; }
.tg { background: var(--internal-soft); border-radius: 10px; padding: 14px 16px; font-size: var(--step-0); border: 1px solid var(--line); }
.tg .who { font-family: var(--font-display); font-size: var(--step--1); color: var(--internal); margin-bottom: 4px; }

/* Tabelas */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: var(--step--1); }
th, td { text-align: left; vertical-align: top; padding: 8px 10px 8px 0; border-bottom: 1px solid var(--line); }
th { font-family: var(--font-display); font-weight: 500; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; }
td:first-child { font-weight: 500; white-space: nowrap; }

/* Detalhe do pedido na prévia */
.order { display: grid; gap: 10px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: 12px; font-size: var(--step--1); }
.order-title { font-family: var(--font-display); font-weight: 500; font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.item { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 10px; align-items: center; }
.thumb { width: 44px; height: 58px; border-radius: 3px; background: linear-gradient(160deg, #e8dccf, #cdb9a4); }
.item .name { font-weight: 500; }
.item .opt { color: var(--muted); }
.sums { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 12px; font-variant-numeric: tabular-nums; }
.sums .total { font-weight: 600; border-top: 1px solid var(--line); padding-top: 4px; }
.facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; }
.facts span { display: block; color: var(--muted); }
.mini { display: flex; gap: 8px; align-items: center; font-size: var(--step--1); }
.mini .thumb { width: 32px; height: 42px; }

/* Galeria de blocos */
.gallery { display: grid; gap: 36px; }
.blk { display: grid; gap: 12px; padding-top: 20px; border-top: 1px solid var(--line); }
.blk-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
.blk-head h3 { font-size: var(--step-1); }
.blk-head .used { font-size: var(--step--1); color: var(--muted); }
.blk-head button { margin-left: auto; font: inherit; font-size: var(--step--1); border: 1px solid var(--brand); color: var(--brand); background: var(--bg); border-radius: 999px; padding: 4px 14px; cursor: pointer; }
.blk-head button:hover, .blk-head button:focus-visible { background: var(--brand-soft); outline: none; }
.blk-desc { font-size: var(--step--1); color: var(--muted); max-width: 70ch; }
.frames { display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start; }
.frame { display: grid; gap: 6px; }
.frame-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-family: var(--font-display); }
.frame-box { overflow: hidden; border: 1px solid var(--line); border-radius: 6px; background: #fff6f0; }
.frame-box > .em { transform-origin: top left; }
dialog.zoom { border: 0; border-radius: 12px; padding: 0; width: min(1080px, 96vw); max-height: 92vh; background: var(--bg); color: var(--ink); }
dialog.zoom::backdrop { background: rgba(42, 33, 24, 0.55); }
.zoom-head { position: sticky; top: 0; background: var(--bg); display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--line); z-index: 1; }
.zoom-head h3 { font-size: var(--step-1); }
.zoom-head button { margin-left: auto; font: inherit; border: 1px solid var(--line); background: var(--bg); border-radius: 999px; padding: 4px 14px; cursor: pointer; }
.zoom-body { display: flex; gap: 24px; padding: 20px; overflow-x: auto; align-items: flex-start; }

/* E-mail: estilos das peças (só valem dentro de .em). Linguagem do site: foto grande, marrom em área cheia, creme de fundo, texto preto. */
.em { container-type: inline-size; background: #fff6f0; padding: 0; font-family: "Poppins", Arial, sans-serif; color: #1c1c1c; font-size: 14px; line-height: 1.6; text-align: left; }
.em * { box-sizing: border-box; }
.em p { margin: 0; }
.em-sec { padding: 28px 44px; display: grid; gap: 14px; }
.em-sec + .em-sec { padding-top: 4px; }
.em-strip { background: #68380a; color: #fff6f0; text-align: center; font-size: 12px; letter-spacing: 0.08em; padding: 10px 16px; }
.em-top { text-align: center; padding: 22px 0 18px; }
.em-logo { width: 140px; height: auto; display: inline-block; }
.em-hero { position: relative; display: block; }
.em-hero img { width: 100%; height: 330px; object-fit: cover; display: block; }
.em-hero .over { position: absolute; left: 0; right: 0; bottom: 0; padding: 70px 44px 28px; background: linear-gradient(to top, rgba(28, 18, 8, 0.62), rgba(28, 18, 8, 0)); color: #ffffff; display: grid; gap: 4px; }
.em-hero .t { font-family: "Newsreader", Georgia, serif; font-weight: 300; font-size: 40px; line-height: 1.05; letter-spacing: -0.01em; }
.em-hero .s { font-size: 13px; letter-spacing: 0.04em; opacity: 0.92; }
.em-eyebrow { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #68380a; font-weight: 500; }
.em-h { font-family: "Newsreader", Georgia, serif; font-weight: 300; font-size: 34px; line-height: 1.1; color: #1c1c1c; margin: 0; }
.em-sub { font-family: "Newsreader", Georgia, serif; font-weight: 400; font-size: 22px; line-height: 1.2; color: #1c1c1c; margin: 0; }
.em-muted { color: #6e6258; font-size: 12px; }
.em-btn { display: inline-block; background: #68380a; color: #fff6f0; text-decoration: none; text-transform: uppercase; letter-spacing: 0.12em; font-size: 12px; font-weight: 500; padding: 16px 32px; text-align: center; }
.em-btn.ghost { background: transparent; color: #68380a; border: 1px solid #68380a; }
.em-center { text-align: center; }
.em-items { display: grid; gap: 18px; }
.em-item { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; gap: 18px; align-items: center; }
.em-item img { width: 96px; height: 144px; object-fit: cover; background: #efe3d6; display: block; }
.em-item .n { font-family: "Newsreader", Georgia, serif; font-size: 19px; line-height: 1.2; }
.em-item .v { color: #6e6258; font-size: 12px; margin-top: 4px; }
.em-item .p { font-variant-numeric: tabular-nums; font-size: 14px; white-space: nowrap; }
.em-rule { border: 0; border-top: 1px solid #e6d5c4; margin: 0; }
.em-sums { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; font-size: 13px; font-variant-numeric: tabular-nums; }
.em-sums .t { font-family: "Newsreader", Georgia, serif; font-size: 22px; padding-top: 8px; border-top: 1px solid #e6d5c4; }
.em-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; font-size: 13px; }
.em-label { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: #68380a; display: block; margin-bottom: 4px; font-weight: 500; }
.em-mini { display: flex; align-items: center; gap: 14px; }
.em-mini .thumbs { display: flex; gap: 6px; flex: none; }
.em-mini img { width: 56px; height: 84px; object-fit: cover; background: #efe3d6; display: block; }
.em-mini .n { font-family: "Newsreader", Georgia, serif; font-size: 18px; line-height: 1.25; }
.em-pix { display: grid; grid-template-columns: 168px minmax(0, 1fr); gap: 24px; align-items: center; background: #ffffff; padding: 22px; }
.em-qr { width: 168px; height: 168px; }
.em-qr svg { width: 100%; height: 100%; display: block; }
.em-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11.5px; background: #fff6f0; border: 1px solid #e6d5c4; padding: 9px 10px; color: #3d3a36; word-break: break-all; line-height: 1.4; }
.em-dates { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; border-top: 1px solid #68380a; border-bottom: 1px solid #68380a; }
.em-date { padding: 16px 0; }
.em-date + .em-date { border-left: 1px solid #e6d5c4; padding-left: 22px; }
.em-date .d { font-family: "Newsreader", Georgia, serif; font-weight: 300; font-size: 32px; line-height: 1.1; color: #68380a; }
.em-tag { justify-self: start; display: inline-block; background: #68380a; color: #fff6f0; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; padding: 6px 12px; font-weight: 500; }
.em-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); position: relative; }
.em-steps::before { content: ""; position: absolute; top: 8px; left: 12.5%; right: 12.5%; border-top: 1px solid #c9ad93; }
.em-step { display: grid; justify-items: center; gap: 8px; text-align: center; position: relative; }
.em-dot { width: 17px; height: 17px; border-radius: 50%; background: #fff6f0; border: 1px solid #c9ad93; }
.em-step.done .em-dot { background: #68380a; border-color: #68380a; }
.em-step.now .em-dot { background: #fff6f0; border: 5px solid #68380a; }
.em-step .s { font-size: 12px; color: #8a7a6c; line-height: 1.3; }
.em-step.done .s, .em-step.now .s { color: #1c1c1c; }
.em-step.now .s { font-weight: 600; color: #68380a; }
.em-track { font-family: "Newsreader", Georgia, serif; font-size: 34px; font-weight: 300; letter-spacing: 0.06em; color: #68380a; font-variant-numeric: tabular-nums; line-height: 1.1; }
.em-link { color: #68380a; font-size: 12px; text-decoration: underline; }
.em-attach { display: flex; align-items: center; gap: 12px; border-top: 1px solid #e6d5c4; padding-top: 14px; font-size: 13px; }
.em-attach .doc { width: 26px; height: 32px; border: 1.5px solid #68380a; position: relative; flex: none; background: #ffffff; }
.em-attach .doc::after { content: ""; position: absolute; left: 5px; right: 5px; top: 9px; height: 10px; border-top: 1.5px solid #68380a; border-bottom: 1.5px solid #68380a; }
.em-care { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 22px; align-items: start; }
.em-care img { width: 150px; height: 225px; object-fit: cover; display: block; }
.em-care ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.em-care li { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 10px; font-size: 13px; padding-top: 10px; border-top: 1px solid #e6d5c4; }
.em-care b { font-weight: 500; color: #68380a; text-transform: uppercase; font-size: 10.5px; letter-spacing: 0.14em; padding-top: 3px; }
.em-choice { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.em-choice span { border: 1px solid #68380a; color: #68380a; text-align: center; padding: 12px 4px; font-size: 13px; background: #ffffff; }
.em-scale { display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); gap: 4px; }
.em-scale span { background: #68380a; color: #fff6f0; text-align: center; padding: 10px 0; font-size: 13px; font-variant-numeric: tabular-nums; }
.em-ends { display: flex; justify-content: space-between; font-size: 11px; color: #6e6258; }
.em-foot { text-align: center; padding: 30px 30px 26px; display: grid; gap: 10px; font-size: 11.5px; color: #68380a; line-height: 1.6; border-top: 1px solid #e6d5c4; }
.em-foot img { width: 100%; max-width: 420px; height: auto; justify-self: center; }
.em-foot a { color: #68380a; }
@container (max-width: 480px) {
  .em-sec { padding: 24px 20px; }
  .em-logo { width: 110px; }
  .em-hero img { height: 380px; }
  .em-hero .over { padding: 50px 20px 20px; }
  .em-hero .t { font-size: 28px; }
  .em-h { font-size: 28px; }
  .em-item { grid-template-columns: 76px minmax(0, 1fr); gap: 14px; }
  .em-item img { width: 76px; height: 114px; }
  .em-item .p { grid-column: 2; }
  .em-cols { grid-template-columns: minmax(0, 1fr); }
  .em-pix { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; padding: 18px; }
  .em-btn { display: block; }
  .em-date .d { font-size: 26px; }
  .em-date + .em-date { padding-left: 14px; }
  .em-track { font-size: 27px; }
  .em-step .s { font-size: 11px; }
  .em-care { grid-template-columns: minmax(0, 1fr); }
  .em-care img { width: 100%; height: 220px; }
  .em-scale span { padding: 9px 0; font-size: 12px; }
}

.tgm { background: #dfe6ec; padding: 22px 18px 26px; font-family: -apple-system, "Segoe UI", Arial, sans-serif; display: grid; gap: 12px; }
.tgm-top { font-size: 12px; color: #5b6b78; text-align: center; }
.tgm-msg { justify-self: start; max-width: 88%; background: #ffffff; border-radius: 4px 14px 14px 14px; padding: 10px 14px 18px; font-size: 14px; line-height: 1.45; color: #1c1c1c; position: relative; box-shadow: 0 1px 1px rgba(0,0,0,0.08); }
.tgm-who { display: block; font-size: 13px; font-weight: 600; color: #3d6f99; margin-bottom: 2px; }
.tgm-time { position: absolute; right: 10px; bottom: 4px; font-size: 11px; color: #8a99a6; }

/* Benchmarks */
.bench { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.case { border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; display: grid; gap: 8px; align-content: start; }
.case-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
.case-head h3 { font-size: var(--step-0); font-weight: 600; }
