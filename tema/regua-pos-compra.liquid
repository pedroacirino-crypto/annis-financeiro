    { name: "Código de rastreio", used: "e-mails 6 e 7", desc: "Código em Newsreader grande e marrom, com o serviço e a data prevista dos Correios.", html: P.rastreio("SEDEX", "Entrega prevista até qui, 15/10") },
    { name: "Botão principal", used: "e-mail 6", desc: "O botão marrom do site. No celular, ocupa a largura toda.", html: P.botao("Rastrear nos Correios") },
